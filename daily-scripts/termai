handle_chat_command() {
  local command="$1"

  case "$command" in
  /example)
    show_examples
    return 0
    ;;
  /help)
    show_chat_help
    return 0
    ;;
  /clear)
    clear
    return 0
    ;;
  /pwd)
    printf "\n"
    printf "${DIM}Current Directory:${RESET} %s\n" "$(pwd)"
    printf "\n"
    return 0
    ;;
  /version)
    show_version
    return 0
    ;;
  /quit | /exit)
    return 2
    ;;
  /*)
    error "Unknown command: $command"
    printf "Use ${BOLD}/help${RESET} to see available commands.\n"
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

