check_dependencies() {
  local missing=()

  command -v curl >/dev/null 2>&1 || missing+=("curl")
  command -v jq >/dev/null 2>&1 || missing+=("jq")

  if ((${#missing[@]} > 0)); then
    error "Missing dependencies: ${missing[*]}"
    exit 1
  fi
}

save_api_key() {
  local key="$1"

  if [[ -z "$key" ]]; then
    error "API key cannot be empty."
    exit 1
  fi

  mkdir -p "$CONFIG_DIR"

  printf 'API_KEY=%q\n' "$key" >"$CONFIG_FILE"
  printf 'MODEL=%q\n' "$MODEL" >>"$CONFIG_FILE"

  chmod 600 "$CONFIG_FILE"

  printf "\n"
  printf "${GREEN}Termai:${RESET} API key saved.\n"
  printf "${DIM}Config:${RESET} %s\n" "$CONFIG_FILE"
  printf "\n"
}

load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    return
  fi

  unset API_KEY
  unset SAVED_MODEL

  # shellcheck disable=SC1090
  source "$CONFIG_FILE"

  if [[ -n "${MODEL:-}" ]]; then
    SAVED_MODEL="$MODEL"
  fi
}

load_api_key() {
  load_config

  if [[ -n "${OPENROUTER_API_KEY:-}" ]]; then
    API_KEY="$OPENROUTER_API_KEY"
  fi

  if [[ -z "${API_KEY:-}" ]]; then
    error "OpenRouter API key is not configured."
    printf "\n"
    printf "Run:\n\n"
    printf '  termai -k "YOUR_OPENROUTER_API_KEY"\n'
    printf "\n"
    exit 1
  fi
}

