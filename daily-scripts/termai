execute_tool() {
  local name="$1"
  local arguments="$2"

  case "$name" in
  get_current_time)
    tool_current_time
    ;;
  web_search)
    local query
    query=$(printf '%s' "$arguments" | jq -r '.query // ""')
    tool_web_search "$query"
    ;;
  get_weather)
    local location
    location=$(printf '%s' "$arguments" | jq -r '.location // ""')
    tool_get_weather "$location"
    ;;
  fetch_url)
    local url
    url=$(printf '%s' "$arguments" | jq -r '.url // ""')
    tool_fetch_url "$url"
    ;;
  get_current_directory)
    tool_pwd
    ;;
  get_direct_file_count)
    tool_direct_file_count
    ;;
  get_recursive_file_count)
    tool_recursive_file_count
    ;;
  list_directory)
    local directory
    directory=$(printf '%s' "$arguments" | jq -r '.directory // "."')
    tool_list_directory "$directory"
    ;;
  read_file)
    local file
    file=$(printf '%s' "$arguments" | jq -r '.file // ""')
    tool_read_file "$file"
    ;;
  find_files)
    local pattern
    pattern=$(printf '%s' "$arguments" | jq -r '.pattern // ""')
    tool_find_files "$pattern"
    ;;
  search_files)
    local query
    query=$(printf '%s' "$arguments" | jq -r '.query // ""')
    tool_search_files "$query"
    ;;
  get_git_status)
    tool_git_status
    ;;
  get_git_diff)
    tool_git_diff
    ;;
  run_command)
    local command
    command=$(printf '%s' "$arguments" | jq -r '.command // ""')
    tool_run_command "$command"
    ;;
  *)
    printf "Unknown tool: %s\n" "$name"
    ;;
  esac
}

run_with_spinner() {
  local output_file="$1"

  shift

  "$@" >"$output_file" 2>&1 &

  local pid=$!
  local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
  local i=0

  while kill -0 "$pid" 2>/dev/null; do
    printf "\r${CYAN}%s${RESET} Thinking..." "${frames[$i]}" >&2
    i=$(((i + 1) % ${#frames[@]}))
    sleep 0.08
  done

  wait "$pid"
  local status=$?

  printf "\r\033[K" >&2

  return "$status"
}

render_code_block() {
  local language="$1"
  local code="$2"

  printf "\n"

  if command -v bat >/dev/null 2>&1; then
    local extension

    case "${language,,}" in
    bash | sh | shell | zsh) extension="sh" ;;
    python | py) extension="py" ;;
    c) extension="c" ;;
    cpp | c++) extension="cpp" ;;
    javascript | js) extension="js" ;;
    typescript | ts) extension="ts" ;;
    rust | rs) extension="rs" ;;
    go) extension="go" ;;
    java) extension="java" ;;
    html) extension="html" ;;
    css) extension="css" ;;
    json) extension="json" ;;
    yaml | yml) extension="yaml" ;;
    toml) extension="toml" ;;
    sql) extension="sql" ;;
    nix) extension="nix" ;;
    *) extension="txt" ;;
    esac

    local temp_file
    temp_file=$(mktemp --suffix=".$extension")

    printf '%s\n' "$code" >"$temp_file"

    bat \
      --paging=never \
      --style='numbers,grid' \
      --color=always \
      "$temp_file"

    rm -f "$temp_file"
  else
    printf '%s\n' "$code"
  fi

  printf "\n"
}

render_inline() {
  local line="$1"

  while [[ "$line" =~ (.*)\*\*([^\*]*)\*\*(.*) ]]; do
    line="${BASH_REMATCH[1]}${BOLD}${BASH_REMATCH[2]}${RESET}${BASH_REMATCH[3]}"
  done

  while [[ "$line" =~ (.*)\`([^\`]*)\`(.*) ]]; do
    line="${BASH_REMATCH[1]}${CYAN}${BASH_REMATCH[2]}${RESET}${BASH_REMATCH[3]}"
  done

  printf "%b" "$line"
}

table_row_regex='^[[:space:]]*\|.*\|[[:space:]]*$'

table_split_row() {
  local row="$1"
  local trimmed="$row"

  trimmed="${trimmed#"${trimmed%%[![:space:]]*}"}"
  trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"

  [[ "$trimmed" == '|'* ]] && trimmed="${trimmed#|}"
  [[ "$trimmed" == *'|' ]] && trimmed="${trimmed%|}"

  local -a raw_cells=()
  local -a cells=()
  local cell

  IFS='|' read -ra raw_cells <<<"$trimmed"

  for cell in "${raw_cells[@]}"; do
    cell="${cell#"${cell%%[![:space:]]*}"}"
    cell="${cell%"${cell##*[![:space:]]}"}"
    cells+=("$cell")
  done

  local joined
  joined=$(
    IFS=$'\x1f'
    printf '%s' "${cells[*]}"
  )

  printf '%s' "$joined"
}

table_is_separator_row() {
  local joined="$1"
  local ncols="$2"
  local -a cells=()

  IFS=$'\x1f' read -ra cells <<<"$joined"

  local any_dash=false
  local i c

  for ((i = 0; i < ncols; i++)); do
    c="${cells[$i]:-}"

    if [[ -n "$c" ]]; then
      if [[ ! "$c" =~ ^:?-+:?$ ]]; then
        return 1
      fi

      any_dash=true
    fi
  done

  [[ "$any_dash" == true ]]
}

table_build_border() {
  local left="$1"
  local mid="$2"
  local right="$3"
  local ncols="$4"

  shift 4

  local -a widths=("$@")
  local out="$left"
  local i k seg

  for ((i = 0; i < ncols; i++)); do
    seg=""

    for ((k = 0; k < widths[i] + 2; k++)); do
      seg+="─"
    done

    out+="$seg"

    ((i < ncols - 1)) && out+="$mid"
  done

  out+="$right"

  printf '%s' "$out"
}

table_wrap_lines() {
  local text="$1"
  local width="$2"

  ((width < 1)) && width=1

  local -a words=($text)
  local -a lines=()
  local cur=""
  local w

  for w in "${words[@]}"; do
    if [[ -z "$cur" ]]; then
      cur="$w"
    elif ((${#cur} + 1 + ${#w} <= width)); then
      cur+=" $w"
    else
      lines+=("$cur")
      cur="$w"
    fi

    while ((${#cur} > width)); do
      lines+=("${cur:0:width}")
      cur="${cur:width}"
    done
  done

  [[ -n "$cur" ]] && lines+=("$cur")
  ((${#lines[@]} == 0)) && lines+=("")

  printf '%s\n' "${lines[@]}"
}

table_compute_widths() {
  local ncols="$1"
  local -n _widths_out="$2"

  shift 2

  local -a natural=("$@")
  local term_width

  term_width=$(tput cols 2>/dev/null)
  [[ -z "$term_width" || "$term_width" -lt 1 ]] && term_width=80

  local overhead=$((ncols * 3 + 1))
  local available=$((term_width - overhead))
  local min_available=$((ncols * 6))

  ((available < min_available)) && available=$min_available

  local sum_natural=0
  local w i

  for w in "${natural[@]}"; do
    sum_natural=$((sum_natural + w))
  done

  if ((sum_natural <= available)); then
    for ((i = 0; i < ncols; i++)); do
      _widths_out[$i]=${natural[$i]}
    done

    return
  fi

  local min_width=6
  local -a share=()
  local total_assigned=0

  for ((i = 0; i < ncols; i++)); do
    local s=$((available * natural[i] / sum_natural))

    ((s < min_width)) && s=$min_width

    share[$i]=$s
    total_assigned=$((total_assigned + s))
  done

  while ((total_assigned > available)); do
    local max_index=0
    local max_value=${share[0]}

    for ((i = 1; i < ncols; i++)); do
      if ((share[i] > max_value)); then
        max_value=${share[$i]}
        max_index=$i
      fi
    done

    ((share[max_index] <= min_width)) && break

    share[$max_index]=$((share[max_index] - 1))
    total_assigned=$((total_assigned - 1))
  done

  for ((i = 0; i < ncols; i++)); do
    _widths_out[$i]=${share[$i]}
  done
}

render_table() {
  local -a raw_rows=("$@")

  ((${#raw_rows[@]} == 0)) && return

  local -a rows=()
  local ncols=0
  local row joined n

  for row in "${raw_rows[@]}"; do
    joined=$(table_split_row "$row")
    rows+=("$joined")
    n=$(($(grep -o $'\x1f' <<<"$joined" | wc -l) + 1))
    ((n > ncols)) && ncols=$n
  done

  local -a data_rows=()

  for row in "${rows[@]}"; do
    if ! table_is_separator_row "$row" "$ncols"; then
      data_rows+=("$row")
    fi
  done

  ((${#data_rows[@]} == 0)) && return

  local -a natural=()
  local i

  for ((i = 0; i < ncols; i++)); do
    natural[$i]=0
  done

  local -a cells
  local c

  for row in "${data_rows[@]}"; do
    IFS=$'\x1f' read -ra cells <<<"$row"

    for ((i = 0; i < ncols; i++)); do
      c="${cells[$i]:-}"
      ((${#c} > natural[i])) && natural[$i]=${#c}
    done
  done

  local -a widths=()

  table_compute_widths "$ncols" widths "${natural[@]}"

  printf "\n${DIM}${CYAN}%s${RESET}\n" \
    "$(table_build_border '┌' '┬' '┐' "$ncols" "${widths[@]}")"

  local row_index=0
  local -a wrapped
  local -a col_lines
  local -a clines
  local max_lines line_i n_lines seg

  for row in "${data_rows[@]}"; do
    IFS=$'\x1f' read -ra cells <<<"$row"

    wrapped=()
    max_lines=1

    for ((i = 0; i < ncols; i++)); do
      c="${cells[$i]:-}"

      mapfile -t col_lines < <(table_wrap_lines "$c" "${widths[$i]}")

      n_lines=${#col_lines[@]}
      ((n_lines > max_lines)) && max_lines=$n_lines

      wrapped[$i]=$(
        IFS=$'\x1e'
        printf '%s' "${col_lines[*]}"
      )
    done

    for ((line_i = 0; line_i < max_lines; line_i++)); do
      printf "${DIM}${CYAN}│${RESET} "

      for ((i = 0; i < ncols; i++)); do
        IFS=$'\x1e' read -ra clines <<<"${wrapped[$i]}"

        seg="${clines[$line_i]:-}"

        if ((row_index == 0)); then
          printf "${BOLD}%-*s${RESET}" "${widths[$i]}" "$seg"
        else
          printf "%-*s" "${widths[$i]}" "$seg"
        fi

        printf " ${DIM}${CYAN}│${RESET} "
      done

      printf "\n"
    done

    if ((row_index == 0)); then
      printf "${DIM}${CYAN}%s${RESET}\n" \
        "$(table_build_border '├' '┼' '┤' "$ncols" "${widths[@]}")"
    fi

    ((row_index++))
  done

  printf "${DIM}${CYAN}%s${RESET}\n\n" \
    "$(table_build_border '└' '┴' '┘' "$ncols" "${widths[@]}")"
}

render_response() {
  local text="$1"

  local in_code=false
  local code=""
  local language=""

  local -a table_buffer=()
  local in_table=false

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$in_table" == true && ! "$line" =~ $table_row_regex ]]; then
      render_table "${table_buffer[@]}"
      table_buffer=()
      in_table=false
    fi

    if [[ "$in_code" == false && "$line" =~ $table_row_regex ]]; then
      table_buffer+=("$line")
      in_table=true
      continue
    fi

    if [[ "$line" == '```'* ]]; then
      if [[ "$in_code" == false ]]; then
        in_code=true
        language="${line#\`\`\`}"
        language="${language## }"
        code=""
      else
        in_code=false
        render_code_block "$language" "$code"
        language=""
        code=""
      fi

      continue
    fi

    if [[ "$in_code" == true ]]; then
      [[ -n "$code" ]] && code+=$'\n'
      code+="$line"
      continue
    fi

    if [[ -z "$line" ]]; then
      printf "\n"
      continue
    fi

    if [[ "$line" =~ ^###\ (.*) ]]; then
      printf "\n${BOLD}${CYAN}%s${RESET}\n" "${BASH_REMATCH[1]}"
      continue
    fi

    if [[ "$line" =~ ^##\ (.*) ]]; then
      printf "\n${BOLD}${CYAN}%s${RESET}\n" "${BASH_REMATCH[1]}"
      continue
    fi

    if [[ "$line" =~ ^#\ (.*) ]]; then
      printf "\n${BOLD}${CYAN}%s${RESET}\n" "${BASH_REMATCH[1]}"
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*[-*+][[:space:]]+(.*) ]]; then
      printf "  • "
      render_inline "${BASH_REMATCH[1]}"
      printf "\n"
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*([0-9]+)\.[[:space:]]+(.*) ]]; then
      printf "  %s. " "${BASH_REMATCH[1]}"
      render_inline "${BASH_REMATCH[2]}"
      printf "\n"
      continue
    fi

    render_inline "$line"
    printf "\n"
  done <<<"$text"

  if [[ "$in_table" == true ]]; then
    render_table "${table_buffer[@]}"
  fi

  if [[ "$in_code" == true ]]; then
    render_code_block "$language" "$code"
  fi
}

build_system_prompt() {
  local context="$1"

  cat <<EOF
You are Termai, an AI assistant running inside the user's terminal.

The user name is Atif and he is from Bhopal, Madhya Pradesh,India.

Be useful, conversational, concise, and technically accurate.

============================================================
TERMINAL AND WEB ACCESS
============================================================

You have access to the user's actual terminal through tools.

SAFE READ-ONLY TOOLS:

- get_current_time
- web_search
- get_weather
- fetch_url
- get_current_directory
- get_direct_file_count
- get_recursive_file_count
- list_directory
- read_file
- find_files
- search_files
- get_git_status
- get_git_diff

These operations do not require approval.

run_command is different.

run_command executes an actual shell command and ALWAYS requires
explicit user approval.

============================================================
WEB RULES
============================================================

These rules are MANDATORY, not suggestions. You must never answer
a question about current, local, or real-world information from
memory alone when a tool can get the real answer.

Use get_current_time when the user asks for the current time,
date, day, timezone, or anything that depends on now.

Use get_weather whenever weather, temperature, rain, forecast, or
conditions are asked about, EVEN INDIRECTLY (e.g. "should I carry
an umbrella", "what's it like outside", "how's the weather at
home"). Never estimate or guess weather from seasonal/general
knowledge. If the user does not name a location, use their known
home location. Call get_weather again if the user asks about a
different location.

Use web_search for anything current, recent, local, or that may
have changed: news, events, "what's going on", prices, sports
results, public webpages, local happenings, or facts you are not
fully certain are still true. Vague queries like "what's going on
in my area" or "any news today" still require at least one
web_search call (e.g. combine the user's known location with
"news" or "events") before you answer — do not fall back to
generic knowledge just because the query is broad. If the first
search is too broad or unhelpful, narrow the query and search
again rather than giving up.

Use fetch_url when the user gives a URL or when web_search returns
a result that should be opened/read before answering.

Never claim you checked the web, weather, or news unless you
actually called web_search, get_weather, or fetch_url in this
turn.

If a tool call fails or returns no usable results, say so plainly
and explicitly (e.g. "the web search failed" / "I couldn't find a
location match"), then answer from general knowledge only if
appropriate — do not silently substitute a guess and present it as
current information.

============================================================
TOOL RULES
============================================================

Always prefer dedicated read-only tools.

Examples:

"What time is it?"
→ get_current_time

"Search the web for latest Node.js version"
→ web_search

"Summarize https://example.com"
→ fetch_url

"What files are here?"
→ list_directory

"Read this script."
→ read_file

"Find files containing config."
→ search_files

"What is my current directory?"
→ get_current_directory

"Show Git status."
→ get_git_status

Do NOT use run_command for these.

Use run_command only when execution or modification is actually
required.

============================================================
GENERIC QUESTIONS
============================================================

If the user asks for a generic example, tutorial, explanation,
or sample code, DO NOT inspect their filesystem.

For example:

"show me a simple Bash script"

should generate a new example.

It should NOT search the user's files.

Only inspect the filesystem when the user asks about their actual
files, project, directory, scripts, or code.

============================================================
ACCURACY
============================================================

Never guess what a file does based only on its filename.

If you need to know what a file does, read it.

Never claim a command was executed unless it actually was.

Never invent terminal output.

For current or changing facts, use web_search or fetch_url.

============================================================
CODE
============================================================

When generating code:

- Make it syntactically valid.
- Use the correct language.
- Put code inside fenced Markdown code blocks.
- Always specify the language.

Example:

\`\`\`bash
echo "Hello"
\`\`\`

============================================================
STYLE
============================================================

Keep responses concise unless the user asks for detail.

Markdown is allowed.

Use proper Markdown tables when useful.

Do not expose internal tool JSON.

CURRENT TERMINAL CONTEXT:

$context
EOF
}

api_request() {
  local messages="$1"
  local tools="$2"
  local output_file="$3"

  local payload

  payload=$(
    jq -n \
      --arg model "$MODEL" \
      --argjson messages "$messages" \
      --argjson tools "$tools" \
      '{
        model: $model,
        messages: $messages,
        tools: $tools,
        tool_choice: "auto"
      }'
  )

  curl -sS \
    --fail-with-body \
    "$API_URL" \
    -H "Authorization: Bearer $API_KEY" \
    -H "Content-Type: application/json" \
    -H "X-Title: Termai" \
    -d "$payload" \
    >"$output_file"
}

ask_ai() {
  local prompt="$1"
  local context="$2"

  local system_prompt
  system_prompt=$(build_system_prompt "$context")

  local messages

  if [[ "$CONVERSATION" == "[]" ]]; then
    messages=$(
      jq -n \
        --arg system "$system_prompt" \
        --arg prompt "$prompt" \
        '[
          {
            role: "system",
            content: $system
          },
          {
            role: "user",
            content: $prompt
          }
        ]'
    )
  else
    messages=$(
      printf '%s' "$CONVERSATION" |
        jq \
          --arg prompt "$prompt" \
          '. + [{
            role: "user",
            content: $prompt
          }]'
    )
  fi

  local tools
  tools=$(build_tools)

  local iteration=0
  local max_iterations=10

  while ((iteration < max_iterations)); do
    iteration=$((iteration + 1))

    local response_file
    response_file=$(mktemp)

    if ! run_with_spinner \
      "$response_file" \
      api_request \
      "$messages" \
      "$tools" \
      "$response_file"; then
      local api_error

      api_error=$(
        jq -r '.error.message // empty' "$response_file" 2>/dev/null
      )

      if [[ -n "$api_error" ]]; then
        error "$api_error"
      else
        error "OpenRouter request failed."
      fi

      rm -f "$response_file"
      return 1
    fi

    if jq -e '.error' "$response_file" >/dev/null 2>&1; then
      local message

      message=$(
        jq -r '.error.message // "Unknown OpenRouter error."' "$response_file"
      )

      error "$message"

      rm -f "$response_file"
      return 1
    fi

    local assistant_message

    assistant_message=$(
      jq -c '.choices[0].message // null' "$response_file"
    )

    if [[ "$assistant_message" == "null" ]]; then
      error "OpenRouter returned no assistant message."
      rm -f "$response_file"
      return 1
    fi

    messages=$(
      printf '%s' "$messages" |
        jq \
          --argjson message "$assistant_message" \
          '. + [$message]'
    )

    local tool_count

    tool_count=$(
      printf '%s' "$assistant_message" |
        jq '.tool_calls // [] | length'
    )

    if ((tool_count == 0)); then
      local answer

      answer=$(
        printf '%s' "$assistant_message" |
          jq -r '.content // ""'
      )

      rm -f "$response_file"

      if [[ -z "$answer" ]]; then
        error "The model returned an empty response."
        return 1
      fi

      print_termai
      render_response "$answer"

      CONVERSATION="$messages"

      return 0
    fi

    local i

    for ((i = 0; i < tool_count; i++)); do
      local tool_call
      local tool_id
      local function_name
      local arguments
      local result

      tool_call=$(
        printf '%s' "$assistant_message" |
          jq -c ".tool_calls[$i]"
      )

      tool_id=$(
        printf '%s' "$tool_call" |
          jq -r '.id'
      )

      function_name=$(
        printf '%s' "$tool_call" |
          jq -r '.function.name'
      )

      arguments=$(
        printf '%s' "$tool_call" |
          jq -r '.function.arguments // "{}"'
      )

      result=$(execute_tool "$function_name" "$arguments")

      messages=$(
        printf '%s' "$messages" |
          jq \
            --arg id "$tool_id" \
            --arg result "$result" \
            '. + [{
              role: "tool",
              tool_call_id: $id,
              content: $result
            }]'
      )
    done

    rm -f "$response_file"
  done

  error "Termai reached the maximum tool-call limit."
  return 1
}

normal_mode() {
  local prompt="$*"
  local context

  context=$(get_terminal_context)

  CONVERSATION="[]"

  ask_ai "$prompt" "$context"
}

file_mode() {
  local file="$1"

  shift

  if [[ ! -f "$file" ]]; then
    error "File not found: $file"
    exit 1
  fi

  local request="$*"

  if [[ -z "$request" ]]; then
    request="Explain this file and what it does."
  fi

  local prompt

  prompt="Analyze this file:

$file

User request:

$request

Use the read_file tool to inspect the file before answering."

  local context

  context=$(get_terminal_context)

  CONVERSATION="[]"

  ask_ai "$prompt" "$context"
}

chat_mode() {
  clear

  local current_directory
  current_directory="$(pwd)"

  printf "\n"

  printf "${DIM}${CYAN}"
  cat <<'EOF'
  ░▓███████▓░
 ▒▓███ ███ █▓▒
  ░▓███████▓░
   ▓▊     █▓
EOF
  printf "${RESET}"

  printf "\n"
  printf "${BOLD}${CYAN}Termai${RESET} ${DIM}— AI in your terminal${RESET}\n\n"
  printf "${DIM}Model:${RESET} %s\n" "$MODEL"
  printf "${DIM}Current Directory:${RESET} %s\n" "$current_directory"
  printf "${DIM}Terminal access:${RESET} enabled\n"
  printf "${DIM}Read-only access:${RESET} enabled\n"
  printf "${DIM}Web access:${RESET} enabled\n"
  printf "${DIM}Type:${RESET} /help for commands • exit / Ctrl+D to quit\n\n"

  separator
  printf "\n"

  local context
  context=$(get_terminal_context)

  CONVERSATION="[]"

  while true; do
    if ! IFS= read -e -r -p "$YOU_PROMPT" message; then
      printf "\n"
      break
    fi

    if [[ "$message" == "exit" ||
      "$message" == "/exit" ||
      "$message" == "/quit" ]]; then
      printf "\n"
      printf "${DIM}Goodbye.${RESET}\n"
      break
    fi

    if [[ -z "$message" ]]; then
      continue
    fi

    handle_chat_command "$message"

    local command_status=$?

    if ((command_status == 2)); then
      printf "\n"
      printf "${DIM}Goodbye.${RESET}\n"
      break
    elif ((command_status == 0)); then
      continue
    fi

    printf "\n"

    ask_ai "$message" "$context"

    printf "\n"
    chat_separator
    printf "\n"
  done
}

main() {
  check_dependencies

  if [[ $# -eq 0 ]]; then
    show_help
    exit 0
  fi

  local chat=false
  local file=""
  local custom_model=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -k | --key)
      if [[ -z "${2:-}" ]]; then
        error "Missing API key."
        exit 1
      fi

      save_api_key "$2"

      exit 0
      ;;
    -c | --chat)
      chat=true
      shift
      ;;
    -f | --file)
      if [[ -z "${2:-}" ]]; then
        error "Missing file."
        exit 1
      fi

      file="$2"

      shift 2
      ;;
    -m | --model)
      if [[ -z "${2:-}" ]]; then
        error "Missing model."
        exit 1
      fi

      custom_model="$2"

      shift 2
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    -v | --version)
      show_version
      exit 0
      ;;
    -*)
      error "Unknown option: $1"
      printf "Run 'termai --help' for help.\n"
      exit 1
      ;;
    *)
      break
      ;;
    esac
  done

  load_api_key

  if [[ -n "$custom_model" ]]; then
    MODEL="$custom_model"
  elif [[ -n "${SAVED_MODEL:-}" ]]; then
    MODEL="$SAVED_MODEL"
  else
    MODEL="$DEFAULT_MODEL"
  fi

  if [[ "$chat" == true ]]; then
    chat_mode
    exit $?
  fi

  if [[ -n "$file" ]]; then
    if [[ $# -gt 0 ]]; then
      file_mode "$file" "$@"
    else
      file_mode "$file"
    fi

    exit $?
  fi

  if [[ $# -eq 0 ]]; then
    error "No prompt provided."
    exit 1
  fi

  normal_mode "$@"
}

main "$@"
