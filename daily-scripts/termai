strip_html() {
  sed \
    -e 's/<script[^>]*>.*<\/script>//Ig' \
    -e 's/<style[^>]*>.*<\/style>//Ig' \
    -e 's/<[^>]*>/ /g' \
    -e 's/&nbsp;/ /g' \
    -e 's/&amp;/\&/g' \
    -e 's/&lt;/</g' \
    -e 's/&gt;/>/g' \
    -e 's/&quot;/"/g' \
    -e "s/&#39;/'/g" |
    awk '{$1=$1; print}' |
    sed '/^$/d'
}

tool_fetch_url() {
  local url="$1"

  if [[ -z "$url" ]]; then
    printf "No URL supplied.\n"
    return
  fi

  if [[ ! "$url" =~ ^https?:// ]]; then
    printf "Only http:// and https:// URLs are supported.\n"
    return
  fi

  local temp_file
  temp_file=$(mktemp)

  if ! curl \
    -L \
    -sS \
    --max-time 20 \
    --connect-timeout 10 \
    -A "Termai/$VERSION" \
    "$url" \
    >"$temp_file"; then
    rm -f "$temp_file"
    printf "Failed to fetch URL: %s\n" "$url"
    return
  fi

  local content_type
  content_type=$(
    curl \
      -L \
      -sS \
      -I \
      --max-time 10 \
      --connect-timeout 5 \
      -A "Termai/$VERSION" \
      "$url" \
      2>/dev/null |
      awk 'BEGIN{IGNORECASE=1} /^content-type:/ {print $0; exit}'
  )

  printf "URL: %s\n" "$url"
  [[ -n "$content_type" ]] && printf "%s\n" "$content_type"
  printf "\n"

  if grep -qiE '<html|<!doctype html' "$temp_file"; then
    strip_html <"$temp_file" | head -c 80000
  else
    head -c 80000 "$temp_file"
  fi

  rm -f "$temp_file"
}

_web_search_ua="Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"

# Try one DuckDuckGo endpoint. Prints parsed results and returns 0 on
# success (>=1 result parsed), returns 1 on any failure so the caller
# can fall back to a different endpoint.
_ddg_try() {
  local query="$1"
  local endpoint="$2"
  local link_pattern="$3"
  local snippet_pattern="$4"

  local temp_file http_code
  temp_file=$(mktemp)

  http_code=$(
    curl \
      -L \
      -sS \
      --max-time 20 \
      --connect-timeout 10 \
      -A "$_web_search_ua" \
      -H "Accept-Language: en-US,en;q=0.9" \
      --get \
      --data-urlencode "q=$query" \
      -o "$temp_file" \
      -w '%{http_code}' \
      "$endpoint" \
      2>/dev/null
  )

  if [[ -z "$http_code" || "$http_code" -lt 200 || "$http_code" -ge 300 ]]; then
    rm -f "$temp_file"
    return 1
  fi

  local parsed
  parsed=$(
    awk -v link_pat="$link_pattern" -v snip_pat="$snippet_pattern" '
      BEGIN { IGNORECASE = 1; count = 0 }

      $0 ~ link_pat {
        line = $0
        gsub(/<[^>]+>/, "", line)
        gsub(/&nbsp;/, " ", line)
        gsub(/&amp;/, "\\&", line)
        gsub(/&#39;/, "'"'"'", line)
        gsub(/&quot;/, "\"", line)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
        if (line != "") {
          title = line
        }
        next
      }

      $0 ~ snip_pat {
        line = $0
        gsub(/<[^>]+>/, "", line)
        gsub(/&nbsp;/, " ", line)
        gsub(/&amp;/, "\\&", line)
        gsub(/&#39;/, "'"'"'", line)
        gsub(/&quot;/, "\"", line)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
        snippet = line
        if (title != "") {
          count++
          printf "%d. %s\n", count, title
          if (snippet != "") {
            printf "   %s\n", snippet
          }
          printf "\n"
          title = ""
          snippet = ""
        }
      }

      END { exit (count == 0) }
    ' "$temp_file" |
      head -n 80
  )
  local awk_status=$?

  rm -f "$temp_file"

  if ((awk_status != 0)) || [[ -z "$parsed" ]]; then
    return 1
  fi

  printf '%s' "$parsed"
  return 0
}

tool_web_search() {
  local query="$1"

  if [[ -z "$query" ]]; then
    printf "No search query supplied.\n"
    return
  fi

  printf "Search query: %s\n\n" "$query"

  local results

  # Primary: DuckDuckGo HTML endpoint (more stable result markup)
  if results=$(_ddg_try \
    "$query" \
    "https://html.duckduckgo.com/html/" \
    'class="result__a"' \
    'class="result__snippet"'); then
    printf '%s\n' "$results"
    return 0
  fi

  # Fallback: DuckDuckGo Lite endpoint
  if results=$(_ddg_try \
    "$query" \
    "https://lite.duckduckgo.com/lite/" \
    'class="result-link"' \
    'result-snippet'); then
    printf '%s\n' "$results"
    return 0
  fi

  printf "Web search failed: both search endpoints were unreachable or blocked the request.\n"
  printf "Try fetch_url with a specific URL instead, or tell the user the search failed.\n"
}

_weather_code_to_text() {
  case "$1" in
  0) printf "Clear sky" ;;
  1) printf "Mainly clear" ;;
  2) printf "Partly cloudy" ;;
  3) printf "Overcast" ;;
  45 | 48) printf "Fog" ;;
  51 | 53 | 55) printf "Drizzle" ;;
  56 | 57) printf "Freezing drizzle" ;;
  61 | 63 | 65) printf "Rain" ;;
  66 | 67) printf "Freezing rain" ;;
  71 | 73 | 75) printf "Snowfall" ;;
  77) printf "Snow grains" ;;
  80 | 81 | 82) printf "Rain showers" ;;
  85 | 86) printf "Snow showers" ;;
  95) printf "Thunderstorm" ;;
  96 | 99) printf "Thunderstorm with hail" ;;
  *) printf "Unknown conditions" ;;
  esac
}

tool_get_weather() {
  local location="$1"

  if [[ -z "$location" ]]; then
    printf "No location supplied.\n"
    return
  fi

  local geo_file
  geo_file=$(mktemp)

  local http_code
  http_code=$(
    curl \
      -sS \
      -L \
      --max-time 15 \
      --connect-timeout 10 \
      -A "Termai/$VERSION" \
      --get \
      --data-urlencode "name=$location" \
      --data-urlencode "count=1" \
      -o "$geo_file" \
      -w '%{http_code}' \
      "https://geocoding-api.open-meteo.com/v1/search" \
      2>/dev/null
  )

  if [[ -z "$http_code" || "$http_code" -lt 200 || "$http_code" -ge 300 ]]; then
    rm -f "$geo_file"
    printf "Weather lookup failed: could not reach the geocoding service.\n"
    return
  fi

  local lat lon place country
  lat=$(jq -r '.results[0].latitude // empty' "$geo_file")
  lon=$(jq -r '.results[0].longitude // empty' "$geo_file")
  place=$(jq -r '.results[0].name // empty' "$geo_file")
  country=$(jq -r '.results[0].country // empty' "$geo_file")

  rm -f "$geo_file"

  if [[ -z "$lat" || -z "$lon" ]]; then
    printf "Weather lookup failed: could not find a location matching \"%s\".\n" "$location"
    return
  fi

  local weather_file
  weather_file=$(mktemp)

  http_code=$(
    curl \
      -sS \
      -L \
      --max-time 15 \
      --connect-timeout 10 \
      -A "Termai/$VERSION" \
      --get \
      --data-urlencode "latitude=$lat" \
      --data-urlencode "longitude=$lon" \
      --data-urlencode "current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m" \
      --data-urlencode "daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code" \
      --data-urlencode "forecast_days=3" \
      --data-urlencode "timezone=auto" \
      -o "$weather_file" \
      -w '%{http_code}' \
      "https://api.open-meteo.com/v1/forecast" \
      2>/dev/null
  )

  if [[ -z "$http_code" || "$http_code" -lt 200 || "$http_code" -ge 300 ]]; then
    rm -f "$weather_file"
    printf "Weather lookup failed: could not reach the forecast service.\n"
    return
  fi

  local temp feels_like humidity precip wind code condition
  temp=$(jq -r '.current.temperature_2m // "?"' "$weather_file")
  feels_like=$(jq -r '.current.apparent_temperature // "?"' "$weather_file")
  humidity=$(jq -r '.current.relative_humidity_2m // "?"' "$weather_file")
  precip=$(jq -r '.current.precipitation // "?"' "$weather_file")
  wind=$(jq -r '.current.wind_speed_10m // "?"' "$weather_file")
  code=$(jq -r '.current.weather_code // "-1"' "$weather_file")
  condition=$(_weather_code_to_text "$code")

  printf "Location: %s%s\n" "$place" "${country:+, $country}"
  printf "Current conditions: %s\n" "$condition"
  printf "Temperature: %s°C (feels like %s°C)\n" "$temp" "$feels_like"
  printf "Humidity: %s%%\n" "$humidity"
  printf "Precipitation: %s mm\n" "$precip"
  printf "Wind speed: %s km/h\n\n" "$wind"

  printf "3-day forecast:\n"

  local i day_count
  day_count=$(jq -r '.daily.time | length' "$weather_file")

  for ((i = 0; i < day_count; i++)); do
    local d hi lo pcode pcond pprob
    d=$(jq -r ".daily.time[$i]" "$weather_file")
    hi=$(jq -r ".daily.temperature_2m_max[$i]" "$weather_file")
    lo=$(jq -r ".daily.temperature_2m_min[$i]" "$weather_file")
    pprob=$(jq -r ".daily.precipitation_probability_max[$i] // \"?\"" "$weather_file")
    pcode=$(jq -r ".daily.weather_code[$i]" "$weather_file")
    pcond=$(_weather_code_to_text "$pcode")

    printf "  %s: %s, high %s°C / low %s°C, %s%% chance of precipitation\n" \
      "$d" "$pcond" "$hi" "$lo" "$pprob"
  done

  rm -f "$weather_file"
}

confirm_command() {
  local command="$1"
  local answer

  printf "\n" >&2
  printf "${YELLOW}${BOLD}Termai wants to run:${RESET}\n" >&2
  printf "  %s\n" "$command" >&2
  printf "\n" >&2
  printf "${YELLOW}Allow? [y/N] ${RESET}" >&2

  read -r answer

  case "$answer" in
  y | Y | yes | YES)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

tool_run_command() {
  local command="$1"

  if [[ -z "$command" ]]; then
    printf "No command supplied.\n"
    return
  fi

  if ! confirm_command "$command"; then
    printf "Command denied by user.\n"
    return
  fi

  printf "\n${DIM}Executing...${RESET}\n\n" >&2

  local output
  local exit_code

  output=$(bash -c "$command" 2>&1)
  exit_code=$?

  [[ -z "$output" ]] && output="(command produced no output)"

  printf "%s\n" "$output" >&2
  printf "\n${DIM}Exit code: %s${RESET}\n" "$exit_code" >&2

  printf '%s' "$output"
}

