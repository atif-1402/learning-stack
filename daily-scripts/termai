get_terminal_context() {
  local cwd
  local os
  local shell_name
  local kernel
  local direct_files
  local recursive_files
  local listing
  local git_status
  local now

  cwd="$(pwd)"
  shell_name="${SHELL##*/}"

  now="$(
    date '+%Y-%m-%d %H:%M:%S %Z (%z)' 2>/dev/null ||
      printf 'unknown'
  )"

  kernel="$(
    uname -sr 2>/dev/null ||
      printf 'unknown'
  )"

  if [[ -f /etc/os-release ]]; then
    os=$(
      . /etc/os-release
      printf '%s' "${PRETTY_NAME:-$NAME}"
    )
  else
    os="$(uname -s)"
  fi

  direct_files=$(
    find . -maxdepth 1 -type f 2>/dev/null |
      wc -l |
      tr -d ' '
  )

  recursive_files=$(
    find . -type f -not -path './.git/*' 2>/dev/null |
      wc -l |
      tr -d ' '
  )

  listing=$(
    find . \
      -maxdepth 2 \
      -not -path './.git' \
      -not -path './.git/*' \
      -printf '%y %p\n' \
      2>/dev/null |
      head -n 200
  )

  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git_status="$(git status --short 2>/dev/null)"
    [[ -z "$git_status" ]] && git_status="Working tree clean."
  else
    git_status="Not a Git repository."
  fi

  cat <<EOF
Current date and time:
$now

Current working directory:
$cwd

Regular files directly inside current directory:
$direct_files

Regular files recursively under current directory:
$recursive_files

Operating system:
$os

Kernel:
$kernel

Shell:
$shell_name

Directory listing:
$listing

Git status:
$git_status
EOF
}

