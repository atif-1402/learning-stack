tool_list_directory() {
  local dir="${1:-.}"

  if [[ ! -d "$dir" ]]; then
    printf "Directory does not exist: %s\n" "$dir"
    return
  fi

  find "$dir" \
    -maxdepth 2 \
    -not -path '*/.git' \
    -not -path '*/.git/*' \
    -printf '%y %p\n' \
    2>/dev/null |
    head -n 300
}

tool_read_file() {
  local file="$1"

  if [[ ! -f "$file" ]]; then
    printf "File does not exist: %s\n" "$file"
    return
  fi

  if file "$file" 2>/dev/null |
    grep -qiE 'binary|image|audio|video|archive'; then
    printf "This appears to be a binary file.\n"
    return
  fi

  local size
  size=$(wc -c <"$file")

  if ((size > 50000)); then
    printf "File is %s bytes. Showing first 50,000 bytes.\n\n" "$size"
    head -c 50000 "$file"
  else
    cat "$file"
  fi
}

tool_find_files() {
  local pattern="$1"

  if [[ -z "$pattern" ]]; then
    printf "No search pattern supplied.\n"
    return
  fi

  find . \
    -type f \
    -not -path './.git/*' \
    -iname "*${pattern}*" \
    2>/dev/null |
    head -n 300
}

tool_search_files() {
  local query="$1"

  if [[ -z "$query" ]]; then
    printf "No search query supplied.\n"
    return
  fi

  if command -v rg >/dev/null 2>&1; then
    rg \
      --hidden \
      --glob '!.git/**' \
      --glob '!*.png' \
      --glob '!*.jpg' \
      --glob '!*.jpeg' \
      --glob '!*.gif' \
      --glob '!*.webp' \
      --glob '!*.mp4' \
      --glob '!*.zip' \
      --glob '!*.tar*' \
      "$query" . \
      2>/dev/null |
      head -n 300
  else
    grep \
      -R \
      -n \
      --exclude-dir=.git \
      "$query" . \
      2>/dev/null |
      head -n 300
  fi
}

